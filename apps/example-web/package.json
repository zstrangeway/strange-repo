{
  "name": "example-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "echo \"example-web: no extra setup beyond pnpm install\"",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "test": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next out node_modules/.cache"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
}
