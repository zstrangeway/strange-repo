# vault-gateway: serves the vault over MCP (Streamable HTTP). mcp-proxy fronts
# mcpvault, which is stdio-only, as two named servers in one process:
#   /servers/read/    the whole vault, read-only
#   /servers/agents/  rooted at Agents/, read-write
# mcp-proxy listens on localhost only; the pod's Caddy is the way in.
#
# Pins: mcp-proxy 0.12.0 doesn't pin its mcp SDK, and the current SDK breaks
# it at import, so mcp is pinned to 1.27.1, the release from its week.
# (supergateway was the first choice; its latest release, 4.1.0, can't bind
# to localhost - that option, like its API keys, is unreleased.)
FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/proxy \
    && /opt/proxy/bin/pip install --no-cache-dir mcp-proxy==0.12.0 mcp==1.27.1 \
    && npm install --global --no-fund --no-audit @bitbonsai/mcpvault@0.16.0 \
    && npm cache clean --force

ENV PATH=/opt/proxy/bin:$PATH
USER 1000
ENTRYPOINT ["mcp-proxy"]
