# Copy to .env and fill in. .env is gitignored; never commit a real key.
# In production these are Fly secrets, not a file:
#   flyctl secrets set RESEND_API_KEY=... -a gary-api

# Postgres. Defaults to postgresql://postgres@127.0.0.1:5432/postgres.
# DATABASE_URL=

# Mail. With nothing set here, gary logs reset links to the console instead of
# sending them, which is usually what you want locally.
#
# MAIL_PROVIDER=resend            # implied anyway by RESEND_API_KEY below
# RESEND_API_KEY=re_xxxxxxxx
#
# Resend's shared test sender is the default and needs no DNS, but it only
# delivers to the address that owns the Resend account. Point MAIL_FROM at an
# address on a domain you have verified before anyone else signs up.
# MAIL_FROM=gary <no-reply@your-domain.example>
